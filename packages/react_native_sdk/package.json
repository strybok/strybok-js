{
  "name": "@strybok/react-native",
  "version": "0.1.0",
  "description": "Strybok deep-link SDK for React Native and Expo: resolves Universal Links / App Links to an in-app route and delivers each link exactly once.",
  "license": "Apache-2.0",
  "homepage": "https://strybok.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strybok/strybok-js.git",
    "directory": "packages/react_native_sdk"
  },
  "bugs": "https://github.com/strybok/strybok-js/issues",
  "keywords": [
    "deep-links",
    "universal-links",
    "app-links",
    "strybok",
    "react-native",
    "expo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@strybok/js": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.65"
  },
  "devDependencies": {
    "@strybok/config": "workspace:*",
    "eslint": "^10.14.0",
    "react": "link:./peer-stubs/react",
    "react-native": "link:./peer-stubs/react-native",
    "typescript": "~6.0.0",
    "vitest": "^4.1.12"
  }
}
